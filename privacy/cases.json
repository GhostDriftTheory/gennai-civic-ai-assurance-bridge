{
  "schema": "civic-privacy-cases/1.0",
  "metadata": {
    "title": "自治体AI・プライバシーアシュアランス PoC第2弾",
    "note": "すべて架空。実住民情報・外部AI・実ネットワーク送信を使用しない。"
  },
  "policy": {
    "id": "CIVIC-PRIVACY-DEMO-02",
    "version": "1.0",
    "as_of": "2026-10-01",
    "purpose": "childcare_guidance",
    "use": "staff_draft",
    "role": "consultation_staff",
    "recipient": "MOCK-AI-JP",
    "terms_version": "DEMO-TERMS-1",
    "region": "DEMO-JP",
    "basis_id": "BASIS-DEMO-01",
    "transform": "minimise-v1",
    "budget_limit": 3,
    "fields": {
      "topic": {
        "label": "相談分野",
        "units": 0
      },
      "age_band": {
        "label": "年代",
        "units": 1
      },
      "household_band": {
        "label": "世帯人数の区分",
        "units": 1
      },
      "area": {
        "label": "広域の地域区分",
        "units": 2
      },
      "income_band": {
        "label": "所得区分（架空）",
        "units": 2
      }
    },
    "gate_names": [
      "対象データと共有範囲",
      "利用目的・用途・人間の確認",
      "利用根拠・操作権限",
      "送信先・取扱条件",
      "送信項目の限定",
      "元データ・変換・送信内容の対応",
      "累積開示の上限",
      "状態確認・重複実行の防止"
    ],
    "output_gate_names": [
      "応答と要求の対応",
      "出力項目の範囲",
      "定型文と内容の一致",
      "職員確認用への用途限定"
    ],
    "disclosure_note": "点数は固定項目の集合に対するデモ上の制約。差分プライバシーのε、再識別確率、法的な安全基準ではない。"
  },
