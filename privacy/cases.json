  "scenarios": [
    {
      "key": "normal",
      "title": "必要項目だけで使う",
      "caption": "氏名・詳細住所を渡さず、案内の下書きを得る。",
      "steps": [
        {
          "test": "normal"
        }
      ]
    },
    {
      "key": "basis",
      "title": "根拠を補って進める",
      "caption": "未確認なら止める。確認記録を補った別の要求で再判定。",
      "steps": [
        {
          "test": "basis_missing"
        },
        {
          "test": "normal"
        }
      ]
    },
    {
      "key": "minimise",
      "title": "氏名を外して進める",
      "caption": "氏名が残る要求は拒否。必要な項目に絞ると利用可能。",
      "steps": [
        {
          "test": "name_in_payload"
        },
        {
          "test": "normal"
        }
      ]
    },
    {
      "key": "recipient",
      "title": "送信先で止める",
      "caption": "同じ情報でも、許可外の送信先には渡さない。",
      "steps": [
        {
          "test": "wrong_recipient"
        }
      ]
    },
    {
      "key": "output",
      "title": "出力の再混入を止める",
      "caption": "送信が許可されても、応答文に氏名が混入すれば採用しない。",
      "steps": [
        {
          "test": "output_name"
        }
      ]
    },
    {
      "key": "unknown",
      "title": "結果不明を保持する",
      "caption": "届いたか確定できない情報は返却扱いにしない。後続処理も保留。",
      "steps": [
        {
          "test": "unknown_outcome"
        },
        {
          "test": "normal",
          "expected_send": "HOLD",
          "expected_adopt": "HOLD"
        }
      ]
    },
    {
      "key": "cumulative",
      "title": "累積開示を追う",
      "caption": "1回ずつなら許容される項目も、組み合わせが上限を超えれば止める。",
      "steps": [
        {
          "test": "normal",
          "changes": {
            "fields": [
              "topic",
              "age_band"
            ]
          }
        },
        {
          "test": "normal",
          "changes": {
            "fields": [
              "topic",
              "household_band"
            ]
          }
        },
        {
          "test": "normal",
          "changes": {
            "fields": [
              "topic",
              "area"
            ]
          },
          "expected_send": "REJECT",
          "expected_adopt": "HOLD"
        },
        {
          "test": "normal",
          "changes": {
            "fields": [
              "topic",
              "age_band"
            ]
          }
        }
      ]
    }
  ]
